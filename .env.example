ANTHROPIC_API_KEY=sk-ant-...

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=eighty-six-dev

# cost levers — see README design notes
EIGHTYSIX_MODEL=claude-opus-5
EIGHTYSIX_ROUTER_MODEL=claude-haiku-4-5

# Freeze the scenario clock for the demo (the supplier tradeoff is
# calendar-dependent). Unset it to use the real clock.
EIGHTYSIX_DEMO_NOW="Friday August 14, 09:30 PM"

# Optional once the embedding model is cached: skips HF hub checks and their
# warnings entirely. Leave unset on first run so the model can download.
# HF_HUB_OFFLINE=1
